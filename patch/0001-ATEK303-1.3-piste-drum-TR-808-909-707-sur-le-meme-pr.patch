+    x ^= x >> 17;
+    x ^= x << 5;
+    *s = x ? x : 1u;
+    return *s;
+}
+static inline float rs_unit(uint32_t *s)     /* uniform 0..1 */
+{
+    return (float)(rs_next(s) >> 8) * (1.0f / 16777216.0f);
+}
+static inline float clamp01(float x)
+{
+    return x < 0.0f ? 0.0f : x > 1.0f ? 1.0f : x;
+}
+
+int drum_gate(const drum_pattern_t *p, int part, int step)
+{
+    if (part < 0 || part >= DR_NPARTS || step < 0 || step >= DR_MAX_STEPS)
+        return 0;
+    return p->gate[part * DR_STEP_BYTES + (step >> 3)] >> (step & 7) & 1;
+}
+int drum_acc(const drum_pattern_t *p, int part, int step)
+{
+    if (part < 0 || part >= DR_NPARTS || step < 0 || step >= DR_MAX_STEPS)
+        return 0;
+    return p->acc[part * DR_STEP_BYTES + (step >> 3)] >> (step & 7) & 1;
+}
+void drum_set_gate(drum_pattern_t *p, int part, int step, int on)
+{
+    if (part < 0 || part >= DR_NPARTS || step < 0 || step >= DR_MAX_STEPS)
+        return;
+    if (on)
+        p->gate[part * DR_STEP_BYTES + (step >> 3)] |= (uint8_t)(1u << (step & 7));
+    else
+        p->gate[part * DR_STEP_BYTES + (step >> 3)] &= (uint8_t)~(1u << (step & 7));
+}
+void drum_set_acc(drum_pattern_t *p, int part, int step, int on)
+{
+    if (part < 0 || part >= DR_NPARTS || step < 0 || step >= DR_MAX_STEPS)
+        return;
+    if (on)
+        p->acc[part * DR_STEP_BYTES + (step >> 3)] |= (uint8_t)(1u << (step & 7));
+    else
+        p->acc[part * DR_STEP_BYTES + (step >> 3)] &= (uint8_t)~(1u << (step & 7));
+}
+
+void drum_clear(drum_pattern_t *p)
+{
+    int i;
+    for (i = 0; i < DR_NPARTS * DR_STEP_BYTES; i++) {
+        p->gate[i] = 0;
+        p->acc[i] = 0;
+    }
+}
+
+void drum_sanitize(drum_pattern_t *p, int steps)
+{
+    int part, s;
+    if (steps < 1)
+        steps = 1;
+    if (steps > DR_MAX_STEPS)
+        steps = DR_MAX_STEPS;
+    for (part = 0; part < DR_NPARTS; part++)
+        for (s = steps; s < DR_MAX_STEPS; s++) {
+            drum_set_gate(p, part, s, 0);
+            drum_set_acc(p, part, s, 0);
+        }
+}
+
+/* ------------------------------------------------------------- generation --- */
+void drum_generate(drum_pattern_t *p, const drum_params_t *prm, uint32_t seed)
+{
+    uint32_t rng = seed ? seed : 1u;
+    int steps = prm->steps < 1 ? 1 : prm->steps > DR_MAX_STEPS ? DR_MAX_STEPS : prm->steps;
+    float dens = clamp01(prm->density), acc = clamp01(prm->accent), fill = clamp01(prm->fill);
+    int s;
+    drum_clear(p);
+    p->seed = rng;
+    for (s = 0; s < steps; s++) {
+        int b = s & 15;                       /* the step inside the bar */
+        int kick, snare, clap, chh, ohh, toml, tomh, cowb;
+
+        /* the kick: the first step when there is any kick at all, the quarters with the density,
+         * and a stray one where the fill asks */
+        if (b == 0)
+            kick = dens > 0.04f;
+        else if ((b & 3) == 0)
+            kick = rs_unit(&rng) < clamp01(dens * 1.9f - 0.45f);
+        else
+            kick = rs_unit(&rng) < dens * 0.10f + fill * 0.14f * dens;
+        if (kick)
+            drum_set_gate(p, DR_KICK, s, 1);
+
+        /* the snare: the backbeat with the density, ghosts with the fill */
+        if (b == 4 || b == 12)
+            snare = rs_unit(&rng) < clamp01(dens * 1.7f - 0.25f);
+        else if ((b & 1) == 0)
+            snare = rs_unit(&rng) < dens * fill * 0.30f;
+        else
+            snare = 0;
+        if (snare)
+            drum_set_gate(p, DR_SNARE, s, 1);
+
+        /* the clap: on the backbeat beside the snare, or answering it two sixteenths later */
+        if (b == 4 || b == 12)
+            clap = rs_unit(&rng) < clamp01(dens * 1.4f - 0.55f);
+        else if ((b & 3) == 2)
+            clap = rs_unit(&rng) < fill * 0.18f;
+        else
+            clap = 0;
+        if (clap)
+            drum_set_gate(p, DR_CLAP, s, 1);
+
+        /* the closed hats: the eighths, the sixteenths when dense */
+        if ((b & 1) == 0)
+            chh = rs_unit(&rng) < clamp01(dens * 2.2f - 0.30f);
+        else
+            chh = rs_unit(&rng) < clamp01((dens - 0.55f) * 1.8f);
+        /* the open hat on the offbeat eighths, taking the step from the closed one */
+        if ((b & 3) == 2)
+            ohh = rs_unit(&rng) < clamp01(dens * 1.3f - 0.40f) * 0.9f;
+        else
+            ohh = 0;
+        if (ohh)
+            chh = 0;
+        if (chh)
+            drum_set_gate(p, DR_CHH, s, 1);
+        if (ohh)
+            drum_set_gate(p, DR_OHH, s, 1);
+
+        /* the toms: sparse talk, and the fill in the last four steps */
+        toml = ((b & 1) == 0) && rs_unit(&rng) < 0.04f + fill * 0.08f;
+        tomh = ((b & 1) == 1) && rs_unit(&rng) < 0.03f + fill * 0.06f;
+        if (s >= steps - 4 && steps >= 12) {
+            if (rs_unit(&rng) < fill * 0.55f)
+                tomh = 1;
+            if (rs_unit(&rng) < fill * 0.30f)
+                toml = 1;
+        }
+        if (toml)
+            drum_set_gate(p, DR_TOML, s, 1);
+        if (tomh)
+            drum_set_gate(p, DR_TOMH, s, 1);
+
+        /* the cowbell: sparse syncopation */
+        cowb = (b == 3 || b == 7 || b == 11 || b == 14) && rs_unit(&rng) < 0.08f + fill * 0.30f;
+        if (cowb)
+            drum_set_gate(p, DR_COWB, s, 1);
+
+        /* the accents: the kick's first step always, the rest with the knob (the hats a little
+         * less, they cut through anyway) */
+        {
+            int part;
+            for (part = 0; part < DR_NPARTS; part++) {
+                if (!drum_gate(p, part, s))
+                    continue;
+                if (part == DR_KICK && b == 0) {
+                    drum_set_acc(p, part, s, 1);
+                    continue;
+                }
+                if (rs_unit(&rng) < (part == DR_CHH || part == DR_OHH ? acc * 0.7f : acc))
+                    drum_set_acc(p, part, s, 1);
+            }
+        }
+    }
+}
+
+/* ------------------------------------------------------------- mutations --- */
+int drum_mutate(drum_pattern_t *p, int layer, uint32_t first_index, int operations, int steps,
+                uint32_t *last, int lo, int hi)
+{
+    uint32_t rng = first_index * 2654435761u + 1u;
+    int op, changed = 0;
+    if (rng == 0u)
+        rng = 1u;
+    if (steps < 1)
+        steps = 1;
+    if (steps > DR_MAX_STEPS)
+        steps = DR_MAX_STEPS;
+    if (lo < 0)
+        lo = 0;
+    if (hi > steps)
+        hi = steps;
+    if (hi <= lo)
+        return 0;
+    for (op = 0; op < operations; op++) {
+        int part = -1, step = lo + (int)(rs_next(&rng) % (uint32_t)(hi - lo));
+        if (layer == DRUM_MUT_ACCENTS) {
+            int tries;
+            for (tries = 0; tries < 8 && part < 0; tries++) {
+                int cand = (int)(rs_next(&rng) % (uint32_t)DR_NPARTS);
+                if (drum_gate(p, cand, step))
+                    part = cand;
+            }
+            if (part >= 0) {
+                drum_set_acc(p, part, step, !drum_acc(p, part, step));
+                changed = 1;
+            }
+        } else {
+            static const uint8_t BACK[3] = {DR_KICK, DR_SNARE, DR_CLAP};
+            static const uint8_t TOP[5] = {DR_CHH, DR_OHH, DR_TOML, DR_TOMH, DR_COWB};
+            if (layer == DRUM_MUT_BACKBONE)
+                part = BACK[rs_next(&rng) % 3u];
+            else if (layer == DRUM_MUT_TOPS)
+                part = TOP[rs_next(&rng) % 5u];
+            else
+                break;
+            if (drum_gate(p, part, step) && rs_unit(&rng) < 0.55f)
+                drum_set_gate(p, part, step, 0);   /* half the moves take a hit away */
+            else
+                drum_set_gate(p, part, step, 1);
+            changed = 1;
+        }
+    }
+    *last = first_index + (uint32_t)operations - 1u;   /* one index an operation, as the acid's burst does */
+    return changed;
+}
diff --git a/atek303/app/dsp/drum_pattern.h b/atek303/app/dsp/drum_pattern.h
new file mode 100644
index 0000000..7914a9c
--- /dev/null
+++ b/atek303/app/dsp/drum_pattern.h
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 Javier (Animatek)
+ *
+ * The drum track's pattern: eight parts of sixty-four steps, a gate and an accent bit each,
+ * bit-packed (a part is eight bytes a layer). What the 303's acid_pattern is to its voice, this
+ * is to the drum engine: a seed grows a pattern with the same flows of chance every time, the
+ * character knobs regrow it from the same seed, and deterministic mutation bursts move it.
+ *
+ * The generator plants a groove, part by part, from the three knobs:
+ *
+ *   DENSITY  how much of the grid plays: the kick's four-on-the-floor, the snare's backbeat,
+ *            the closed hats' eighths, and everything else, denser as it rises.
+ *   ACCENTS  the chance that a hit lands accented (the kick's first step always is).
+ *   FILL     ghost notes, offbeat claps, toms: the seasoning, and the last four steps' fill.
+ *
+ * The mutation layers follow the buttons the 303 mutates with: ENV moves the backbone (kick,
+ * snare, clap), LFO the tops (hats, toms, cowbell), ARP the accents. */
+#pragma once
+#include <stdint.h>
+#include "drum_voice.h"                       /* DR_NPARTS and the parts' order */
+
+#define DR_MAX_STEPS 64                       /* as the 303: four pages of sixteen */
+#define DR_STEP_BYTES 8                       /* sixty-four steps, a bit each */
+
+typedef struct {
+    uint32_t seed;
+    uint8_t gate[DR_NPARTS * DR_STEP_BYTES];
+    uint8_t acc[DR_NPARTS * DR_STEP_BYTES];
+} drum_pattern_t;
+
+typedef struct {
+    int steps;                                /* 1..64 */
+    float density, accent, fill;              /* 0..1 */
+} drum_params_t;
+
+enum { DRUM_MUT_BACKBONE = 1, DRUM_MUT_TOPS = 2, DRUM_MUT_ACCENTS = 3 };
+
+int drum_gate(const drum_pattern_t *p, int part, int step);
+int drum_acc(const drum_pattern_t *p, int part, int step);
+void drum_set_gate(drum_pattern_t *p, int part, int step, int on);
+void drum_set_acc(drum_pattern_t *p, int part, int step, int on);
+void drum_clear(drum_pattern_t *p);
+/* the gates beyond the length out (the length shrunk) */
+void drum_sanitize(drum_pattern_t *p, int steps);
+/* the same seed, the same pattern, every time */
+void drum_generate(drum_pattern_t *p, const drum_params_t *prm, uint32_t seed);
+/* a burst of deterministic mutations on one layer within the steps [lo, hi); *last takes the
+ * mutation counter to continue from. 0 = nothing changed. */
+int drum_mutate(drum_pattern_t *p, int layer, uint32_t first_index, int operations, int steps,
+                uint32_t *last, int lo, int hi);
diff --git a/atek303/app/dsp/drum_voice.c b/atek303/app/dsp/drum_voice.c
new file mode 100644
index 0000000..36733f5
--- /dev/null
+++ b/atek303/app/dsp/drum_voice.c
@@ -0,0 +1,464 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 Javier (Animatek)
+ *
+ * The drum track's eight voices. See drum_voice.h for the circuit each one models. The numbers
+ * come from the classic machines' recipes (the 808 hat's six square ratios, the clap's three
+ * pre-echoes, the kick's resonant pitch drop), tuned by ear against them. Envelopes decay
+ * geometrically (a per-sample factor), filters are an RBJ band-pass biquad and a one-pole
+ * high-pass, their coefficients computed at the hit, never per sample. */
+#include "drum_voice.h"
+#include "fastmath.h"
+
+#define TAU_FLOOR 0.0004f                    /* an envelope under this is done (-72 dB) */
+#define CLICK_TAU 0.0022f                    /* the kick's click, about 2 ms */
+#define ACCENT_BOOST 1.20f                   /* what a full accent adds to the gain */
+#define CLAP_PRE 0.011f                      /* the clap's pre-echoes, 11 ms apart */
+#define CLAP_PRE_TAU 0.0038f                 /* their short decay */
+#define CLAP_PRE_N 3                         /* three of them */
+#define CHOKED_TAU 0.025f                    /* a choked open hat dies in about 25 ms */
+
+const char *const DR_PART_NAME[DR_NPARTS] = {"KICK", "SNARE", "CLAP", "HAT C", "HAT O", "TOM L", "TOM H", "COWBELL"};
+const char *const DR_KIT_NAME[DR_NKITS] = {"808", "909", "707"};
+
+const char *dr_part_label(int part, int kit)
+{
+    return part == DR_COWB && kit == DR_KIT_707 ? "RIMSHOT" : DR_PART_NAME[part];
+}
+
+float dr_swing_seconds(float sw, float period)
+{
+    if (sw < 0.0f)
+        sw = 0.0f;
+    if (sw > 1.0f)
+        sw = 1.0f;
+    return sw * (1.0f / 3.0f) * period;      /* 75 % seats the offbeat on the triplet */
+}
+
+/* ----------------------------------------------------------------- helpers --- */
+static inline float noise_white(uint32_t *st)
+{
+    uint32_t x = *st;
+    x ^= x << 13;
+    x ^= x >> 17;
+    x ^= x << 5;
+    *st = x;
+    return (float)(int32_t)x * (1.0f / 2147483648.0f);
+}
+/* the envelope one step on; the voice ends when it falls under the floor */
+static inline float env_run(float *env, float c, int *on)
+{
+    float e = *env * c;
+    if (e < TAU_FLOOR) {
+        e = 0.0f;
+        *on = 0;
+    }
+    *env = e;
+    return e;
+}
+static inline float env_step(float *env, float c)
+{
+    return *env *= c;
+}
+static void env_set(dr_part_t *v, float tau_s, float sr)
+{
+    if (tau_s < 0.001f)
+        tau_s = 0.001f;
+    v->env = 1.0f;
+    v->env_c = fm_expf(-1.0f / (tau_s * sr));
+}
+/* a band-pass biquad and a one-pole high-pass, RBJ cookbook; at the hit, not per sample */
+static void set_bp(dr_part_t *v, float freq, float q, float sr)
+{
+    float w = FM_TWO_PI * freq / sr, s = fm_sinf(w), c = fm_cosf(w);
+    float alpha = s / (2.0f * q), scale = 1.0f / (1.0f + alpha);
+    v->a1 = 2.0f * c * scale;
+    v->a2 = (alpha - 1.0f) * scale;
+    v->b0 = alpha * scale;
+    v->b1 = 0.0f;
+    v->b2 = -alpha * scale;
+    v->x1 = v->x2 = v->y1 = v->y2 = 0.0f;
+}
+static inline float bq_run(dr_part_t *v, float x)
+{
+    float y = v->b0 * x + v->b1 * v->x1 + v->b2 * v->x2 + v->a1 * v->y1 + v->a2 * v->y2;
+    v->x2 = v->x1;
+    v->x1 = x;
+    v->y2 = v->y1;
+    v->y1 = y;
+    return y;
+}
+static void set_hp(dr_part_t *v, float fc, float sr)
+{
+    float x = fm_expf(-FM_TWO_PI * fc / sr);
+    v->hp_b0 = 0.5f * (1.0f + x);
+    v->hp_b1 = -v->hp_b0;
+    v->hp_a1 = x;
+    v->hp_x1 = v->hp_y1 = 0.0f;
+}
+static inline float hp_run(dr_part_t *v, float x)
+{
+    float y = v->hp_b0 * x + v->hp_b1 * v->hp_x1 + v->hp_a1 * v->hp_y1;
+    v->hp_x1 = x;
+    v->hp_y1 = y;
+    return y;
+}
+static inline float semitones(float x)       /* TUNE's centre detent: -12..+12 semitones */
+{
+    return fm_powf(2.0f, (x - 0.5f) * 2.0f);
+}
+static inline float sq(float ph)             /* a square's sign, the phase already wrapped */
+{
+    return ph < 3.14159265f ? 1.0f : -1.0f;
+}
+
+/* --------------------------------------------------------------- the voices --- */
+static void trig_kick(dr_part_t *v, float acc, float sr)
+{
+    float fend = 47.0f * semitones(v->tune), fstart, ptau, atau, click;
+    if (v->kit == DR_KIT_909) {
+        fstart = fend * 5.2f;
+        ptau = 0.008f;
+        atau = 0.055f + 0.50f * v->decay;
+        click = 0.85f;
+    } else if (v->kit == DR_KIT_707) {
+        fstart = fend * 3.4f;
+        ptau = 0.014f;
+        atau = 0.065f + 0.45f * v->decay;
+        click = 0.45f;
+    } else {                                  /* 808 */
+        fstart = fend * 2.3f;
+        ptau = 0.026f;
+        atau = 0.10f + 0.60f * v->decay;
+        click = 0.12f;
+    }
+    v->w1 = FM_TWO_PI * fstart / sr;          /* the pitch's start */
+    v->w2 = FM_TWO_PI * fend / sr;            /* its seat */
+    v->pc = 1.0f;
+    v->pc_c = fm_expf(-1.0f / (ptau * sr));
+    v->ph1 = v->ph2 = 0.0f;
+    env_set(v, atau, sr);
+    v->click = 1.0f;
+    v->click_c = fm_expf(-1.0f / (CLICK_TAU * sr));
+    v->hit_acc = acc;
+    v->env2 = 0.0f;
+}
+static float rend_kick(dr_part_t *v)
+{
+    float s, click;
+    v->ph1 += v->w2 + (v->w1 - v->w2) * v->pc;
+    v->ph2 += v->w2;
+    v->pc *= v->pc_c;
+    s = fm_tanhf(fm_sinf(v->ph1) * 1.9f) * 0.85f + 0.15f * fm_sinf(v->ph2);
+    click = noise_white(&v->seed) * v->click;
+    click *= env_step(&v->click, v->click_c);
+    return (s * env_run(&v->env, v->env_c, &v->on) + click) * v->hit_acc * v->level;
+}
+
+static void trig_snare(dr_part_t *v, float acc, float sr)
+{
+    float f1, f2, nbp, hpf, tgain, ntau, bt;
+    if (v->kit == DR_KIT_909) {
+        f1 = 168.0f;
+        f2 = 331.0f;
+        nbp = 3400.0f;
+        hpf = 430.0f;
+        tgain = 0.60f;
+        ntau = 0.10f + 0.30f * v->decay;
+        bt = 0.034f;
+    } else if (v->kit == DR_KIT_707) {
+        f1 = 190.0f;
+        f2 = 376.0f;
+        nbp = 2500.0f;
+        hpf = 520.0f;
+        tgain = 0.40f;
+        ntau = 0.08f + 0.26f * v->decay;
+        bt = 0.030f;
+    } else {                                  /* 808 */
+        f1 = 185.0f;
+        f2 = 330.0f;
+        nbp = 1800.0f;
+        hpf = 340.0f;
+        tgain = 0.85f;
+        ntau = 0.09f + 0.34f * v->decay;
+        bt = 0.040f;
+    }
+    f1 *= semitones(v->tune);
+    f2 *= semitones(v->tune);
+    v->w1 = FM_TWO_PI * f1 / sr;
+    v->w2 = FM_TWO_PI * f2 / sr;
+    v->ph1 = v->ph2 = 0.0f;
+    set_bp(v, nbp, 0.8f, sr);
+    set_hp(v, hpf, sr);
+    env_set(v, ntau, sr);
+    v->env2 = 1.0f;
+    v->env2_c = fm_expf(-1.0f / (bt * sr));
+    v->hit_acc = acc;
+    v->pc = tgain;                            /* the tone's gain rides in the pitch-drop spare */
+}
+static float rend_snare(dr_part_t *v)
+{
+    float n = noise_white(&v->seed);
+    float body = fm_sinf(v->ph1) + 0.6f * fm_sinf(v->ph2);
+    v->ph1 += v->w1;
+    v->ph2 += v->w2;
+    n = hp_run(v, bq_run(v, n));
+    body *= env_step(&v->env2, v->env2_c);
+    return (body * v->pc + n * env_run(&v->env, v->env_c, &v->on) * 1.5f) * v->hit_acc * v->level * 0.70f;
+}
+
+static void trig_clap(dr_part_t *v, float acc, float sr)
+{
+    set_bp(v, 1080.0f * semitones(v->tune), 1.7f, sr);
+    set_hp(v, 380.0f, sr);
+    v->t = 0.0f;
+    v->bursts = CLAP_PRE_N;
+    v->next_burst = CLAP_PRE;
+    v->tail = 0;
+    v->env = 1.0f;
+    v->env_c = fm_expf(-1.0f / (CLAP_PRE_TAU * sr));
+    v->env2_c = fm_expf(-1.0f / ((0.09f + 0.30f * v->decay) * sr));
+    v->hit_acc = acc;
+}
+static float rend_clap(dr_part_t *v, float sr)
+{
+    float n = hp_run(v, bq_run(v, noise_white(&v->seed)));
+    v->t += 1.0f / sr;
+    env_step(&v->env, v->env_c);
+    if (v->bursts && v->t >= v->next_burst) { /* a pre-echo lands: the envelope jumps back up */
+        v->bursts--;
+        v->next_burst += CLAP_PRE;
+        v->env = 1.0f;
+    }
+    if (!v->tail && v->t >= CLAP_PRE * (float)(CLAP_PRE_N + 1)) {
+        v->tail = 1;                          /* the main tail takes over from the last echo */
+        v->env_c = v->env2_c;
+        if (v->env < 0.8f)
+            v->env = 0.8f;
+    }
+    return n * env_run(&v->env, v->env_c, &v->on) * v->hit_acc * v->level * 2.6f;
+}
+
+/* the hats: the 808's six squares, or filtered noise */
+static void trig_hat(dr_part_t *v, float acc, float sr, int open)
+{
+    float tau = open ? 0.16f + 0.55f * v->decay : 0.028f + 0.09f * v->decay;
+    int i;
+    if (v->kit == DR_KIT_909)
+        tau *= 0.72f;
+    else if (v->kit == DR_KIT_707)
+        tau *= 0.85f;
+    for (i = 0; i < 6; i++)
+        v->hph[i] = 0.0f;
+    set_bp(v, 10000.0f, 0.55f, sr);
+    set_hp(v, v->kit == DR_KIT_808 ? 7800.0f : v->kit == DR_KIT_909 ? 8600.0f : 6900.0f, sr);
+    env_set(v, tau, sr);
+    v->hit_acc = acc;
+    v->pc = open ? 1.05f : 1.0f;              /* the part's raw gain rides in the pitch-drop spare */
+}
+static float rend_hat(dr_part_t *v, float sr)
+{
+    float s;
+    if (v->kit == DR_KIT_808) {
+        static const float FR[6] = {263.0f, 400.0f, 421.0f, 474.0f, 587.0f, 845.0f};
+        float tune = semitones(v->tune);
+        int i;
+        s = 0.0f;
+        for (i = 0; i < 6; i++) {
+            v->hph[i] += FM_TWO_PI * FR[i] * 2.0f * tune / sr;
+            if (v->hph[i] >= FM_TWO_PI)
+                v->hph[i] -= FM_TWO_PI;
+            s += sq(v->hph[i]);
+        }
+        s *= 0.30f;
+    } else {
+        s = noise_white(&v->seed) * 0.9f;
+        if (v->kit == DR_KIT_707)
+            s = s * 0.7f + 0.3f * noise_white(&v->seed);
+    }
+    return hp_run(v, bq_run(v, s)) * env_run(&v->env, v->env_c, &v->on) * v->hit_acc * v->level * v->pc;
+}
+
+static void trig_tom(dr_part_t *v, float acc, float sr, float base)
+{
+    float f = base * semitones(v->tune);
+    float sweep = v->kit == DR_KIT_707 ? 2.1f : v->kit == DR_KIT_909 ? 1.55f : 1.35f;
+    v->w1 = FM_TWO_PI * f * sweep / sr;
+    v->w2 = FM_TWO_PI * f / sr;
+    v->pc = 1.0f;
+    v->pc_c = fm_expf(-1.0f / ((v->kit == DR_KIT_707 ? 0.05f : 0.028f) * sr));
+    v->ph1 = v->ph2 = 0.0f;
+    env_set(v, 0.10f + 0.45f * v->decay, sr);
+    v->hit_acc = acc;
+}
+static float rend_tom(dr_part_t *v)
+{
+    float s;
+    v->ph1 += v->w2 + (v->w1 - v->w2) * v->pc;
+    v->ph2 += v->w2 * 2.0f;
+    v->pc *= v->pc_c;
+    s = fm_sinf(v->ph1) + 0.22f * fm_sinf(v->ph2);
+    return fm_tanhf(s * 1.3f) * env_run(&v->env, v->env_c, &v->on) * v->hit_acc * v->level;
+}
+
+static void trig_cowb(dr_part_t *v, float acc, float sr)
+{
+    float f1;
+    if (v->kit == DR_KIT_707) {               /* the rimshot: a square and a noise burst, band-passed */
+        f1 = 485.0f * semitones(v->tune);
+        set_bp(v, 1750.0f, 1.1f, sr);
+        env_set(v, 0.030f + 0.10f * v->decay, sr);
+        v->env2 = 1.0f;
+        v->env2_c = fm_expf(-1.0f / (0.006f * sr));
+    } else {                                  /* the 808's cowbell: two squares into a band-pass */
+        float f2;
+        f1 = 540.0f * semitones(v->tune);
+        f2 = 800.0f * semitones(v->tune);
+        set_bp(v, 2640.0f, 1.1f, sr);
+        env_set(v, 0.10f + 0.42f * v->decay, sr);
+        v->env2 = 1.0f;
+        v->env2_c = fm_expf(-1.0f / (0.028f * sr));
+        v->w2 = FM_TWO_PI * f2 / sr;
+        v->ph2 = 0.0f;
+    }
+    v->w1 = FM_TWO_PI * f1 / sr;
+    v->ph1 = 0.0f;
+    v->hit_acc = acc;
+}
+static float rend_cowb(dr_part_t *v)
+{
+    float s;
+    v->ph1 += v->w1;
+    if (v->ph1 >= FM_TWO_PI)
+        v->ph1 -= FM_TWO_PI;
+    if (v->kit == DR_KIT_707) {
+        s = (sq(v->ph1) + 0.8f * noise_white(&v->seed)) * 0.6f * env_step(&v->env2, v->env2_c);
+        return bq_run(v, s) * env_run(&v->env, v->env_c, &v->on) * v->hit_acc * v->level;
+    }
+    v->ph2 += v->w2;
+    if (v->ph2 >= FM_TWO_PI)
+        v->ph2 -= FM_TWO_PI;
+    s = (sq(v->ph1) + sq(v->ph2)) * 0.55f * (0.55f + 0.45f * env_step(&v->env2, v->env2_c));
+    return bq_run(v, s) * env_run(&v->env, v->env_c, &v->on) * v->hit_acc * v->level * 0.78f;
+}
+
+/* ------------------------------------------------------------------ machine --- */
+void dr_init(dr_machine_t *d, float sr)
+{
+    int i, j;
+    d->sr = sr;
+    d->kit = DR_KIT_808;
+    d->acc_amt = 1.0f;
+    for (i = 0; i < DR_NPARTS; i++) {
+        dr_part_t *v = &d->p[i];
+        v->on = 0;
+        v->kit = DR_KIT_808;
+        v->env = 0.0f;
+        v->env2 = 0.0f;
+        v->level = 0.8f;
+        v->tune = 0.5f;
+        v->decay = 0.5f;
+        v->hit_acc = 1.0f;
+        v->seed = 0x9E3779B9u * (uint32_t)(i + 7);
+        for (j = 0; j < 6; j++)
+            v->hph[j] = 0.0f;
+        set_bp(v, 1000.0f, 1.0f, sr);
+        set_hp(v, 500.0f, sr);
+    }
+}
+
+void dr_set(dr_machine_t *d, int part, int param, float value)
+{
+    dr_part_t *v;
+    if (part < 0 || part >= DR_NPARTS || param < 0 || param >= DR_NPAR)
+        return;
+    v = &d->p[part];
+    if (value < 0.0f)
+        value = 0.0f;
+    if (value > 1.0f)
+        value = 1.0f;
+    if (param == DR_LEVEL)
+        v->level = value;
+    else if (param == DR_TUNE)
+        v->tune = value;
+    else
+        v->decay = value;
+}
+
+void dr_kit(dr_machine_t *d, int kit)
+{
+    int i;
+    if (kit < 0 || kit >= DR_NKITS)
+        return;
+    d->kit = kit;
+    for (i = 0; i < DR_NPARTS; i++)
+        d->p[i].kit = kit;
+}
+
+void dr_accamt(dr_machine_t *d, float value)
+{
+    d->acc_amt = fm_clampf(value, 0.0f, 1.0f);
+}
+
+void dr_trigger(dr_machine_t *d, int part, int accent)
+{
+    dr_part_t *v;
+    float acc;
+    if (part < 0 || part >= DR_NPARTS)
+        return;
+    v = &d->p[part];
+    acc = accent ? 1.0f + d->acc_amt * ACCENT_BOOST : 1.0f;
+    v->on = 1;
+    switch (part) {
+    case DR_KICK: trig_kick(v, acc, d->sr); break;
+    case DR_SNARE: trig_snare(v, acc, d->sr); break;
+    case DR_CLAP: trig_clap(v, acc, d->sr); break;
+    case DR_CHH:
+        trig_hat(v, acc, d->sr, 0);
+        {                                     /* the pedal: a closed hat chokes the open one */
+            dr_part_t *o = &d->p[DR_OHH];
+            if (o->on)
+                o->env_c = fm_expf(-1.0f / (CHOKED_TAU * d->sr));
+        }
+        break;
+    case DR_OHH: trig_hat(v, acc, d->sr, 1); break;
+    case DR_TOML: trig_tom(v, acc, d->sr, 96.0f); break;
+    case DR_TOMH: trig_tom(v, acc, d->sr, 176.0f); break;
+    default: trig_cowb(v, acc, d->sr); break;
+    }
+}
+
+void dr_panic(dr_machine_t *d)
+{
+    int i;
+    for (i = 0; i < DR_NPARTS; i++)
+        d->p[i].on = 0;
+}
+
+void dr_render(dr_machine_t *d, float *out, uint32_t n)
+{
+    uint32_t i;
+    int p;
+    for (i = 0; i < n; i++)
+        out[i] = 0.0f;
+    for (p = 0; p < DR_NPARTS; p++) {
+        dr_part_t *v = &d->p[p];
+        if (!v->on)
+            continue;
+        for (i = 0; i < n; i++) {
+            float s;
+            switch (p) {
+            case DR_KICK: s = rend_kick(v); break;
+            case DR_SNARE: s = rend_snare(v); break;
+            case DR_CLAP: s = rend_clap(v, d->sr); break;
+            case DR_CHH:
+            case DR_OHH: s = rend_hat(v, d->sr); break;
+            case DR_TOML:
+            case DR_TOMH: s = rend_tom(v); break;
+            default: s = rend_cowb(v); break;
+            }
+            out[i] += s;
+            if (!v->on)
+                break;                        /* it died inside the block */
+        }
+    }
+}
diff --git a/atek303/app/dsp/drum_voice.h b/atek303/app/dsp/drum_voice.h
new file mode 100644
index 0000000..ca41fb9
--- /dev/null
+++ b/atek303/app/dsp/drum_voice.h
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 Javier (Animatek)
+ *
+ * ATEK303's drum track for the M-VAVE FM-1: eight analogue-modelled percussion voices in the
+ * TR-808 / TR-909 / TR-707 spirit, in single-precision C with no libm (fastmath.h, as the 303's
+ * atek_voice.c). All synthesis, no samples: the firmware stays small and every voice follows its
+ * LEVEL knob live; TUNE and DECAY apply at the next hit.
+ *
+ * The voices, and the circuit each one is modelled on:
+ *
+ *   KICK    a sine with an exponential pitch drop (the bridged-T resonant circuit's ringing) and
+ *           an amplitude decay, plus a short noise click on top (the 909's attack transient).
+ *           The kit sets how fast the pitch falls and how loud the click: 808 long and round,
+ *           909 fast and punchy, 707 in between.
+ *   SNARE   two detuned body sines with their own fast decay, plus white noise through a
+ *           band-pass and a high-pass (the 808's 180/330 Hz tank + noise; the 909 brighter and
+ *           noisier, the 707 cleaner).
+ *   CLAP    noise through a band-pass, struck four times: three pre-echoes 11 ms apart and the
+ *           main tail (the 808's four envelopes on one noise generator).
+ *   HAT C   on the 808 kit, six detuned square oscillators (its metallic ring: 263, 400, 421,
+ *           474, 587 and 845 Hz, doubled) through a band-pass and a high-pass; on the 909 and
+ *           707, filtered noise, brighter and darker. Short decay.
+ *   HAT O   the same generator with a long decay. A closed hat chokes it (the machines' shared
+ *           envelope), always: the classic pedal behaviour, no option.
+ *   TOM L   a sine with a pitch drop and a soft second partial (the 808's conga line, tuned
+ *           low; the 707's tom sweeps more).
+ *   TOM H   the same, tuned high.
+ *   COWB    two detuned squares (the 808 cowbell's 540/800 Hz) through a band-pass: a fast drop
+ *           and a short tail. On the 707 kit this part plays a rimshot instead (a narrow burst
+ *           of square and noise, band-passed at 1.7 kHz).
+ *
+ * Every voice runs only while it rings; an envelope under its silence floor stops it. One
+ * trigger() per hit, with the accent as gain. Threads: dr_render() and dr_trigger() run in the
+ * audio interrupt; dr_set(), dr_kit(), dr_accamt() between blocks. */
+#pragma once
+#include <stdint.h>
+
+/* the eight parts, the matrix editor's rows in this order */
+enum { DR_KICK, DR_SNARE, DR_CLAP, DR_CHH, DR_OHH, DR_TOML, DR_TOMH, DR_COWB, DR_NPARTS };
+
+/* the kits: the flavour of every voice at once */
+enum { DR_KIT_808 = 0, DR_KIT_909 = 1, DR_KIT_707 = 2 };
+#define DR_NKITS 3
+
+/* the three knobs per part, 0..1 */
+enum { DR_LEVEL, DR_TUNE, DR_DECAY, DR_NPAR };
+
+typedef struct {
+    int on;                               /* it rings */
+    int kit;                              /* the machine's kit at the last hit */
+    float t;                              /* seconds since the hit */
+    float env, env_c;                     /* the main amplitude envelope and its per-sample factor */
+    float env2, env2_c;                   /* the second envelope (bodies, tails) */
+    float hit_acc;                        /* the accent's gain at the hit (level applies live) */
+    float ph1, ph2, ph3;                  /* the oscillator phases */
+    float w1, w2, w3;                     /* their frequencies, radians a sample */
+    float pc, pc_c;                       /* the pitch drop: 1 at the hit, decaying */
+    float click, click_c;                 /* the kick's click envelope */
+    int bursts;                           /* the clap's pre-echoes left */
+    float next_burst;                     /* when the next one lands */
+    int tail;                             /* the clap's tail armed */
+    float hph[6];                         /* the 808 hat's six square phases */
+    float hp_b0, hp_b1, hp_a1, hp_x1, hp_y1;                              /* one-pole high-pass */
+    float b0, b1, b2, a1, a2, x1, x2, y1, y2;                             /* band-pass biquad */
+    float level, tune, decay;             /* the part's knobs, 0..1 */
+    uint32_t seed;                        /* the voice's own noise stream */
+} dr_part_t;
+
+typedef struct {
+    float sr;
+    int kit;
+    float acc_amt;                        /* how much an accent opens (0..1) */
+    dr_part_t p[DR_NPARTS];
+    uint32_t rng;                         /* the shared noise stream (the kick's click, the 909 hats) */
+} dr_machine_t;
+
+void dr_init(dr_machine_t *d, float sr);
+void dr_set(dr_machine_t *d, int part, int param, float value);   /* 0..1, between blocks */
+void dr_kit(dr_machine_t *d, int kit);                            /* 0..2, between blocks */
+void dr_accamt(dr_machine_t *d, float value);                     /* 0..1, between blocks */
+void dr_trigger(dr_machine_t *d, int part, int accent);           /* a hit; render or between blocks */
+void dr_panic(dr_machine_t *d);                                   /* every voice silent */
+/* n mono samples, about -1..1: all the voices that ring, each with its LEVEL */
+void dr_render(dr_machine_t *d, float *out, uint32_t n);
+
+extern const char *const DR_PART_NAME[DR_NPARTS];      /* KICK, SNARE, CLAP, ... (short, for the screen) */
+extern const char *const DR_KIT_NAME[DR_NKITS];        /* 808, 909, 707 */
+/* the cowbell plays a rimshot on the 707 kit: the name follows */
+const char *dr_part_label(int part, int kit);
+/* the swing of an offbeat step, seconds: sw 0..1 (the knob's 50..75 %) over a sixteenth */
+float dr_swing_seconds(float sw, float period);
